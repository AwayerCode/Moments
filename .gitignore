# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Secrets and local env — never commit values
.env
.env.*
!.env.example
.dev.vars
.dev.vars*

# Cloudflare local state and generated binding types
.wrangler
worker-configuration.d.ts

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Blender automatic backups
*.blend[0-9]*

# Reproducible intermediate UV bakes; the runtime GLB embeds the final maps.
assets/lookdev/*-diffuse.png
assets/lookdev/*-normal.png
assets/lookdev/runtime-atlas-*.png
assets/lookdev/runtime-atlas-*.jpg
assets/lookdev/runtime-staging.glb

# Python helper bytecode
__pycache__/
