# Local / Worker secrets. Copy to `.dev.vars` (preferred for Wrangler)
# or `.env` in this directory. Never commit real values.
#
# Generate ACCESS_NAME_HASH from a dummy local name (not a real person):
#   npm run hash-name -- --salt <ACCESS_SALT> --name <dummy-name>
#
# Production: wrangler secret put ACCESS_SALT
#             wrangler secret put ACCESS_NAME_HASH
#             wrangler secret put SESSION_SECRET

ACCESS_SALT=
ACCESS_NAME_HASH=
SESSION_SECRET=
