# Local / Worker secrets. Copy to `.dev.vars` (preferred for Wrangler)
# or `.env` in this directory. Never commit real values.
#
# Generate ACCESS_INVITE_HASH from a local-only invitation token:
#   npm run hash-invite -- --salt <ACCESS_SALT> --invite <local-invite-token>
#
# Production: wrangler secret put ACCESS_SALT
#             wrangler secret put ACCESS_INVITE_HASH
#             wrangler secret put SESSION_SECRET

ACCESS_SALT=
ACCESS_INVITE_HASH=
SESSION_SECRET=
